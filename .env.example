# ──────────────────────────────────────────────────────────────
# Local environment contract for the Collaborative Code Editor
#
#   cp .env.example .env
#   # then set APP_JWT_SECRET below
#   docker compose up --build
#
# APP_JWT_SECRET is the only value you must provide. Everything
# else already defaults to the sibling containers defined in
# docker-compose.yml, so uncomment a line only to override it.
# ──────────────────────────────────────────────────────────────

# ── JWT Auth (required) ───────────────────────────────────────
# HMAC-SHA signing secret for access tokens. Must be at least 32
# characters; the app refuses to start otherwise. Generate one:
#
#   openssl rand -base64 48
#
# Never commit a real secret — .env is gitignored for this reason.
APP_JWT_SECRET=

# ── Database (optional overrides) ─────────────────────────────
# JDBC URL for the PostgreSQL container defined in docker-compose.yml.
#APP_DB_URL=jdbc:postgresql://postgres:5432/collabeditor
#APP_DB_USERNAME=collabeditor
#APP_DB_PASSWORD=collabeditor

# ── Redis (optional overrides) ────────────────────────────────
#APP_REDIS_HOST=redis
#APP_REDIS_PORT=6379

# ── Docker socket (optional override) ─────────────────────────
# Socket path as seen by the Docker daemon host. Mounted into the
# app container so sandboxed execution can reach the same daemon.
# Keep /var/run/docker.sock for Docker Desktop, Linux, and Colima
# Compose runs. Do not point this at ~/.colima/...
#DOCKER_SOCKET_PATH=/var/run/docker.sock
